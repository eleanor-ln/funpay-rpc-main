{
  "name": "funpay-rpc",
  "version": "1.0.2",
  "description": "FunPay desktop client with Discord Rich Presence",
  "author": "flouz152",
  "private": true,
  "license": "MIT",
  "main": "./tsc/main.js",
  "scripts": {
    "dev": "tsc && npm run copy-header && electron ./tsc/main.js --dev",
    "build": "tsc && npm run copy-header && electron-builder --dir",
    "build-win": "tsc && npm run copy-header && electron-builder -w nsis --publish never",
    "build-linux-appimage": "tsc && npm run copy-header && electron-builder -l appimage",
    "build-linux-deb": "tsc && npm run copy-header && electron-builder -l deb",
    "build-mac": "tsc && npm run copy-header && electron-builder -m dmg",
    "copy-header": "cpx \"src/header/**/*\" tsc/header"
  },
  "build": {
    "appId": "com.funpay.rpc",
    "productName": "FunPay RPC",
    "asar": true,
    "asarUnpack": ["assets/stylus-mv2/**/*"],
    "files": ["tsc/**/*", "assets/funpay/**/*", "assets/stylus-mv2/**/*", "themes/**/*", "sounds/**/*", "!node_modules/electron/**/*"],
    "directories": { "output": "build" },
    "win": { "target": "nsis", "icon": "assets/funpay/funpay.ico", "signAndEditExecutable": false, "artifactName": "funpay-rpc-${version}-win.${ext}" },
    "mac": { "target": "dmg", "icon": "assets/funpay/funpay.png", "artifactName": "funpay-rpc-${version}-mac.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "executableName": "funpay-rpc",
      "artifactName": "funpay-rpc-${version}-linux.${ext}",
      "icon": "assets/funpay/funpay.png",
      "desktop": { "entry": { "Name": "FunPay RPC", "Comment": "FunPay client with Discord Rich Presence", "Categories": "Network;" } }
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.0",
    "discord-api-types": "^0.38.18",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "cpx": "^1.5.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.7.0",
    "typescript": "^5.9.2"
  }
}
